<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dictionaries.App.Views.CreateDictionaryPage"
             Title="Новий словник">

    <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="500" VerticalOptions="Center">
        <Label Text="Створення словника" FontSize="24" FontAttributes="Bold" />

        <VerticalStackLayout Spacing="6">
            <Label Text="Назва словника" FontSize="14" />
            <Entry x:Name="NameEntry"
                   Placeholder="Наприклад: Англо-український"
                   TextChanged="OnInputTextChanged" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="6">
            <Label Text="Мова оригіналу (з якої перекладаємо)" FontSize="14" />
            <Entry x:Name="SourceLangEntry"
                   Placeholder="Наприклад: Англійська"
                   TextChanged="OnInputTextChanged" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="6">
            <Label Text="Мова перекладу (на яку перекладаємо)" FontSize="14" />
            <Entry x:Name="TargetLangEntry"
                   Placeholder="Наприклад: Українська"
                   TextChanged="OnInputTextChanged" />
        </VerticalStackLayout>

        <Label x:Name="ErrorLabel"
               TextColor="#C62828"
               FontSize="14"
               IsVisible="False" />

        <HorizontalStackLayout Spacing="12" Margin="0,8,0,0">
            <Button Text="Створити"
                    Clicked="OnSaveClicked"
                    HeightRequest="44"
                    Padding="22,0"
                    CornerRadius="10"
                    FontAttributes="Bold" />
            <Button Text="Скасувати"
                    Clicked="OnCancelClicked"
                    HeightRequest="44"
                    Padding="18,0"
                    CornerRadius="10" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
