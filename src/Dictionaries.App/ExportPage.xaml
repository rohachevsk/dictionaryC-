<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dictionaries.App.ExportPage"
             Title="Експорт слова">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Button Text="← Назад"
                    Clicked="OnBackClicked"
                    HorizontalOptions="Start" />

            <Border StrokeShape="RoundRectangle 10"
                    Padding="15">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Слово:"
                           FontSize="13"
                           Opacity="0.7" />
                    <Label Text="{Binding WordEntry.Word}"
                           FontSize="22"
                           FontAttributes="Bold" />

                    <Label Text="Переклади:"
                           FontSize="13"
                           Opacity="0.7"
                           Margin="0,6,0,0" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding WordEntry.Translations}"
                                         Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding ., StringFormat='• {0}'}"
                                       FontSize="16" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Формат файлу:"
                   FontAttributes="Bold" />
            <Picker ItemsSource="{Binding Formats}"
                    SelectedItem="{Binding SelectedFormat}" />

            <Label Text="Шлях збереження файлу:"
                   FontAttributes="Bold" />
            <Grid ColumnDefinitions="*, Auto"
                  ColumnSpacing="8">
                <Entry Grid.Column="0"
                       Text="{Binding FilePath}"
                       Placeholder="Наприклад: D:\Exports\apple.txt" />
                <Button Grid.Column="1"
                        Text="На Робочий стіл"
                        Command="{Binding ResetDefaultPathCommand}" />
            </Grid>

            <Button Text="Експортувати"
                    Command="{Binding ExportCommand}"
                    FontAttributes="Bold"
                    Margin="0,6,0,0" />

            <Label Text="{Binding StatusMessage}"
                   FontSize="14" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>